# Variables de entorno públicas para la landing web de DITEON

# Endpoint público de la Edge Function capture-lead
# Ejemplo: https://<project-ref>.supabase.co/functions/v1/capture-lead
VITE_CAPTURE_LEAD_FUNCTION_URL=

# Site Key pública de Cloudflare Turnstile.
# Nunca colocar TURNSTILE_SECRET_KEY en frontend.
VITE_TURNSTILE_SITE_KEY=

# URL del endpoint / webhook backend para recibir leads del formulario de contacto (opcional/legado)
# Ejemplo: https://api.diteon.com/v1/leads o webhook de n8n/Supabase/Make
VITE_CONTACT_API_URL=

# Número oficial de WhatsApp de DITEON con prefijo internacional
# Ejemplo: +51987654321
VITE_WHATSAPP_NUMBER=

# Supabase Configuration (Public Client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canales de comunicación oficiales opcionales
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_CALENDLY_URL=

